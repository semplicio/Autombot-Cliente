<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" xmlns:tools="http://schemas.android.com/tools" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- CORRECAO: faltava essa permissao pro WakeLock (Etapa 73) funcionar de
         verdade — confirmado por log real do usuario, o pedido de WakeLock estava
         sendo recusado com SecurityException toda vez ("Neither user ... nor
         current process has android.permission.WAKE_LOCK"), silenciosamente (so
         logava o erro, nao travava nada) — a correcao da Etapa 73 nunca chegou a
         ter efeito nenhum ate agora. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Pede pro usuario isentar o app da otimizacao de bateria padrao do Android
         (Doze) — VPNs precisam disso pra continuar rodando em segundo plano.
         Fabricantes como Motorola costumam ter uma camada PROPRIA de gerenciamento
         de bateria alem dessa, que precisa de ajuste manual separado nas
         configuracoes do fabricante — essa permissao so cobre a camada padrao do
         Android. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="AutomBot Connect"
        android:theme="@style/Theme.AutomBotClient"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.AutomBotClient">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deeplink para import de perfil/painel: autombot://import?panel=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="autombot" android:host="import" />
            </intent-filter>
        </activity>

        <service
            android:name=".core.AutomBotVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <!-- Obrigatorio no Android 14+ (API 34) pra foregroundServiceType="specialUse" —
                 sem isso, startForeground() lanca excecao e o codigo depois dele (o motor
                 de roteamento inteiro) nunca chega a rodar. Provavel causa de a chave de
                 VPN acender mas nada de trafego funcionar. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
        </service>

        <!-- Servico interno do backend oficial do WireGuard (com.wireguard.android:tunnel) -->
        <service
            android:name="com.wireguard.android.backend.GoBackend$VpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

    </application>
</manifest>